  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "framer-motion": ">=11",
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.2.15",
    "framer-motion": "^11.15.0",
    "html2canvas": "1.4.1",
    "react": "^19.2.6",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@shadergradient/react": "^2.4.20"
