{
  "name": "@arcanea/skills",
  "version": "1.1.0",
  "description": "A measured bundle of Arcanea creative and engineering skills with previewable, non-overwriting installation",
  "main": "index.js",
  "types": "index.d.ts",
  "bin": {
    "arcanea-skills": "bin/install.js"
  },
  "files": [
    "skills/",
    "bin/",
    "lib/",
    "index.js",
    "index.d.ts",
    "README.md"
  ],
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "check": "node --check bin/install.js && node --check lib/installer.js && node --check index.js",
    "install-skills": "node bin/install.js",
    "list": "node -e \"const s = require('./index.js'); console.log(s.skills.join('\\n'));\""
  },
  "keywords": [
    "claude-code",
    "skills",
    "ai",
