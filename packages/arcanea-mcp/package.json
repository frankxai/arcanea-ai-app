{
  "name": "@arcanea/mcp-server",
  "version": "1.1.0",
  "private": false,
  "description": "MCP server that audits a world against its canon: WorldPack canon, rights and provenance checks with rule ids and fixes, seal verification, plus Arcanea worldbuilding tools.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./tools/generators": "./dist/tools/generators.js",
    "./tools/world-intelligence": "./dist/tools/world-intelligence.js",
    "./tools/visual-prompts": "./dist/tools/visual-prompts.js",
    "./tools/creation-graph": "./dist/tools/creation-graph.js",
    "./gateway": "./dist/gateway/index.js"
  },
  "bin": {
    "arcanea-mcp": "./dist/cli.js"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && node scripts/vendor-world-pack.mjs",
    "dev": "tsc --watch",
    "start": "node dist/cli.js",
    "clean": "rm -rf dist",
    "test:gateway": "pnpm run build && node --test tests/world-context-gateway.test.mjs",
    "test:worldpack": "pnpm run build && node --test tests/worldpack-tools.test.mjs tests/hardening.test.mjs tests/public-canon.test.mjs tests/publish-workflow.test.mjs tests/public-counts.test.mjs",
    "smoke:consumer": "node scripts/consumer-smoke.mjs",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "mcp",
    "arcanea",
    "worldbuilding",
    "canon",
    "continuity",
    "story-bible",
    "worldpack",
    "creative",
    "ai",
    "fantasy",
    "character-generator",
    "world-intelligence",
    "model-context-protocol",
    "claude",
    "cursor",
    "windsurf"
  ],
  "author": "FrankX <frank@frankx.ai>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frankxai/arcanea-ai-app.git",
    "directory": "packages/arcanea-mcp"
  },
  "homepage": "https://arcanea.ai/docs/mcp",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "canonicalize": "^1.0.8",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.18.1 <21 || >=22.0.0"
  }
}
