{
  "name": "@arcanea/router-spec",
  "version": "1.0.2",
  "repository": {
    "type": "git",
    "url": "https://github.com/frankxai/arcanea-ai-app.git",
    "directory": "packages/router-spec"
  },
  "homepage": "https://arcanea.ai/orchestrator",
  "bugs": "https://github.com/frankxai/arcanea-ai-app/issues",
  "author": "Arcanea (frankxai)",
  "license": "MIT",
  "description": "Canonical model routing spec for the Arcanea ecosystem. Single source of truth consumed by claude-arcanea, oh-my-arcanea, arcanea-flow, and arcanea.ai/models.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./models.yaml": "./models.yaml"
  },
  "files": [
    "dist",
    "models.yaml",
    "manifest.schema.yaml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "validate": "tsx src/validate.ts",
    "test": "tsx --test tests/validate.test.ts"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
