{
  "name": "@starlight/multilingual",
  "version": "0.1.0",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "description": "Starlight multilingual foundation — path-based routing, translated slugs, canon glossary, AEO JSON-LD with provenance, llms.txt + sitemap generation, community translation pipeline. Cross-property infrastructure for any Next.js site in the Frank ecosystem.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./routing": {
      "types": "./dist/routing.d.ts",
      "default": "./dist/routing.js"
    },
    "./middleware": {
      "types": "./dist/middleware.d.ts",
      "default": "./dist/middleware.js"
    },
    "./seo": {
      "types": "./dist/seo.d.ts",
      "default": "./dist/seo.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "default": "./dist/schema.js"
    },
    "./slugs": {
      "types": "./dist/slugs.d.ts",
      "default": "./dist/slugs.js"
    },
    "./glossary": {
      "types": "./dist/glossary.d.ts",
      "default": "./dist/glossary.js"
    },
    "./book": {
      "types": "./dist/book.d.ts",
      "default": "./dist/book.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist dist-test",
    "build:test": "tsc -p tsconfig.test.json",
    "test": "pnpm run build:test && node --test dist-test/test/"
  },
  "peerDependencies": {
    "next": ">=14",
    "next-intl": ">=4"
  },
  "peerDependenciesMeta": {
    "next-intl": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "@types/node": "^20.0.0"
  }
}
