{
  "name": "@arcanea/swarm-coordinator",
  "version": "0.1.0",
  "description": "Multi-agent swarm coordination with topology-aware task distribution, workflow execution, and Guardian-integrated consensus",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/swarm-coordinator.test.mjs"
  },
  "keywords": [
    "arcanea",
    "swarm",
    "coordinator",
    "agent",
    "task",
    "workflow",
    "orchestration"
  ],
  "license": "MIT",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/frankxai/arcanea-ai-app.git",
    "directory": "packages/swarm-coordinator"
  },
  "bugs": {
    "url": "https://github.com/frankxai/arcanea-ai-app/issues"
  },
  "homepage": "https://github.com/frankxai/arcanea-ai-app/tree/main/packages/swarm-coordinator"
}
