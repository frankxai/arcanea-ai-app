{
  "name": "@arcanea/starlight-runtime",
  "version": "0.2.0",
  "description": "Context loader for Starlight Protocol files — reads and assembles agent context from disk",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc -w",
    "test": "node --test tests/*.test.mjs",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "starlight",
    "agent",
    "protocol",
    "context",
    "ai",
    "llm",
    "context-loader"
  ],
  "author": "FrankX <frank@frankx.ai>",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/frankxai/arcanea.git",
    "directory": "packages/starlight-runtime"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "zod": "^4.4.3",
    "ai": "^6.0.174",
    "@ai-sdk/anthropic": "^3.0.74",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "@types/node": "^25.6.0"
  }
}
