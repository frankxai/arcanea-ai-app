{
  "name": "@arcanea/orchestrator",
  "version": "1.2.1",
  "description": "The Arcanea Orchestrator — headless brain that routes, plans, swarms, and learns across claude / opencode / codex / gemini. Consumes @arcanea/router-spec.",
  "repository": {
    "type": "git",
    "url": "https://github.com/frankxai/arcanea-ai-app.git",
    "directory": "packages/orchestrator"
  },
  "homepage": "https://arcanea.ai/orchestrator",
  "bugs": "https://github.com/frankxai/arcanea-ai-app/issues",
  "author": "Arcanea (frankxai)",
  "license": "MIT",
  "keywords": [
    "arcanea",
    "orchestrator",
    "agent",
    "cli",
    "multi-agent",
    "claude-code",
    "opencode",
    "codex",
    "gemini",
    "routing"
  ],
  "type": "module",
  "main": "./dist/cli.js",
  "bin": {
    "arcanea-orchestrator": "./dist/cli.js",
    "arco": "./dist/cli.js"
  },
  "files": [
    "dist",
    "scripts",
    "workflows",
    "AGENTS.md",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "test": "pnpm build && tsx --test tests/config.test.ts tests/runtimes.test.ts tests/cli-smoke.test.ts",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@arcanea/router-spec": "workspace:*",
    "commander": "^12.1.0",
    "execa": "^9.5.0",
    "kleur": "^4.1.5",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "@types/node": "^20.19.41"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  }
}
