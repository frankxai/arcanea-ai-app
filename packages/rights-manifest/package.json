{
  "name": "@arcanea/rights-manifest",
  "version": "0.1.0",
  "description": "Machine-readable rights manifest, licence-template registry and fail-closed consistency validation for Arcanea creative assets",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema.json": "./schema/arcanea.rights_manifest.v0.schema.json"
  },
  "files": [
    "dist",
    "schema",
    "examples",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "test": "node --test tests/*.test.ts",
    "schema:generate": "node scripts/generate-json-schema.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "zod": "^4.6.6"
  },
  "engines": {
    "node": ">=22"
  }
}
