{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcanea.ai/schemas/worldpack.v1.schema.json",
  "title": "WorldPack.v1",
  "description": "A portable, creator-owned Arcanean world. Every node carries owner, provenance, version, branch, visibility, canon status, rights, and an evaluation rule.",
  "type": "object",
  "required": [
    "format",
    "packVersion",
    "world",
    "canon",
    "nodes",
    "relationships",
    "branches",
    "versions",
    "sources"
  ],
  "additionalProperties": false,
  "properties": {
    "format": { "const": "WorldPack.v1" },
    "packVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "interop": { "$ref": "#/$defs/interop" },
    "exportedAt": { "type": ["string", "null"], "format": "date-time" },
    "digest": { "$ref": "#/$defs/contentHash" },
    "counts": {
      "type": "object",
      "additionalProperties": { "type": "integer" }
    },
    "world": {
      "type": "object",
      "required": ["id", "name", "creatorRef"],
      "properties": {
        "id": { "type": "string", "pattern": "^wld_[0-9A-HJKMNP-TV-Z]{26}$" },
        "name": { "type": "string", "minLength": 2, "maxLength": 80 },
        "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "creatorRef": { "type": "string" }
      }
    },
    "canon": {
      "type": "object",
      "description": "Binding to the canon document this world was checked against.",
      "required": ["document"],
      "properties": {
        "document": { "type": "string" },
        "sourceHash": {
          "oneOf": [{ "$ref": "#/$defs/contentHash" }, { "type": "null" }]
        }
      }
    },
    "provenance": {
      "type": "object",
      "properties": {
        "sources": { "type": "array", "items": { "$ref": "#/$defs/Source" } },
        "branches": { "type": "array", "items": { "$ref": "#/$defs/Branch" } },
        "versions": { "type": "array", "items": { "$ref": "#/$defs/Version" } },
        "head": { "type": ["string", "null"] }
      }
    },
    "nodes": { "type": "array", "items": { "$ref": "#/$defs/EntityNode" } },
    "relationships": {
      "type": "array",
      "items": { "$ref": "#/$defs/Relationship" }
    },
    "branches": { "type": "array", "items": { "$ref": "#/$defs/Branch" } },
    "versions": { "type": "array", "items": { "$ref": "#/$defs/Version" } },
    "sources": { "type": "array", "items": { "$ref": "#/$defs/Source" } },
    "agentRoles": { "type": "array", "items": { "$ref": "#/$defs/AgentRole" } }
  },
  "$defs": {
    "contentHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "interop": {
      "type": "object",
      "description": "Explicit versioned interface to @arcanea/world-sdk's world.arcanea.json standard.",
      "properties": {
        "standard": { "const": "world.arcanea.json" },
        "schemaVersion": { "type": "string" },
        "contentHashFormat": { "type": "string" },
        "idPrefixes": { "type": "object" }
      }
    },
    "EntityType": {
      "enum": [
        "Universe",
        "World",
        "Era",
        "Location",
        "Faction",
        "Character",
        "Creature",
        "Object",
        "Law",
        "Power",
        "Event",
        "Scene",
        "Artifact",
        "Creator"
      ]
    },
    "Layer": {
      "description": "Ownership separation: Arcanea canon, user worlds, licensed assets, generated drafts, public contributions.",
      "enum": ["canon", "user", "licensed", "generated", "contributed"]
    },
    "RightsState": {
      "enum": [
        "arcanea-owned",
        "creator-owned",
        "licensed",
        "community-contributed",
        "unresolved"
      ]
    },
    "CanonStatus": {
      "enum": [
        "locked",
        "staging",
        "evolving",
        "draft",
        "non-canon",
        "rejected"
      ]
    },
    "Visibility": { "enum": ["public", "unlisted", "private"] },
    "Rights": {
      "type": "object",
      "required": ["state"],
      "properties": {
        "state": { "$ref": "#/$defs/RightsState" },
        "spdx": { "type": ["string", "null"] },
        "licenceRef": { "type": ["string", "null"] },
        "commercial": { "type": "boolean" },
        "attribution": { "type": "boolean" }
      }
    },
    "Governance": {
      "type": "object",
      "description": "Every node answers: who owns it, where it came from, which version and branch, who can see it, how canonical it is, what rights apply, and how it is evaluated.",
      "required": ["owner", "visibility", "canonStatus", "rights", "evalRule"],
      "properties": {
        "owner": { "type": "string" },
        "sourceRef": { "type": ["string", "null"] },
        "versionRef": { "type": ["string", "null"] },
        "branchRef": { "type": ["string", "null"] },
        "visibility": { "$ref": "#/$defs/Visibility" },
        "canonStatus": { "$ref": "#/$defs/CanonStatus" },
        "rights": { "$ref": "#/$defs/Rights" },
        "evalRule": { "type": "string" }
      }
    },
    "EntityNode": {
      "type": "object",
      "required": ["id", "type", "name", "layer", "governance"],
      "properties": {
        "id": { "type": "string" },
        "type": { "$ref": "#/$defs/EntityType" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "layer": { "$ref": "#/$defs/Layer" },
        "attributes": { "type": "object" },
        "provenance": {
          "type": "object",
          "description": "Set when a node came out of an APL compile.",
          "properties": {
            "apl": { "type": "string" },
            "aplVersion": { "type": "string" },
            "promptHash": { "$ref": "#/$defs/contentHash" }
          }
        },
        "governance": { "$ref": "#/$defs/Governance" }
      }
    },
    "Relationship": {
      "type": "object",
      "required": ["id", "type", "kind", "from", "to", "governance"],
      "properties": {
        "id": { "type": "string" },
        "type": { "const": "Relationship" },
        "kind": {
          "enum": [
            "part_of",
            "located_at",
            "member_of",
            "bonded_to",
            "guards",
            "opposes",
            "allies_with",
            "wields",
            "created_by",
            "derived_from",
            "occurs_in",
            "precedes",
            "governed_by",
            "echoes"
          ]
        },
        "from": { "type": "string" },
        "to": { "type": "string" },
        "strength": { "type": "number", "minimum": 0, "maximum": 1 },
        "governance": { "$ref": "#/$defs/Governance" }
      }
    },
    "Branch": {
      "type": "object",
      "required": ["id", "type", "name", "head"],
      "properties": {
        "id": { "type": "string" },
        "type": { "const": "Branch" },
        "name": { "type": "string" },
        "parent": { "type": ["string", "null"] },
        "head": { "type": ["string", "null"] },
        "forkedFrom": { "type": ["string", "null"] },
        "owner": { "type": ["string", "null"] },
        "createdAt": { "type": "string" }
      }
    },
    "Version": {
      "type": "object",
      "required": ["id", "type", "branch", "parents", "createdAt"],
      "properties": {
        "id": { "type": "string" },
        "type": { "const": "Version" },
        "branch": { "type": "string" },
        "parents": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string" },
        "createdBy": { "type": ["string", "null"] },
        "message": { "type": ["string", "null"] },
        "digest": {
          "oneOf": [{ "$ref": "#/$defs/contentHash" }, { "type": "null" }]
        }
      }
    },
    "Source": {
      "type": "object",
      "required": ["id", "kind"],
      "properties": {
        "id": { "type": "string" },
        "kind": {
          "enum": [
            "creator-input",
            "canon-document",
            "licensed-asset",
            "model-output",
            "public-contribution",
            "external-reference"
          ]
        },
        "uri": { "type": ["string", "null"] },
        "citation": { "type": ["string", "null"] },
        "retrievedAt": { "type": ["string", "null"] },
        "contentHash": {
          "oneOf": [{ "$ref": "#/$defs/contentHash" }, { "type": "null" }]
        }
      }
    },
    "AgentRole": {
      "type": "object",
      "required": ["id", "type", "name", "role", "authority"],
      "properties": {
        "id": { "type": "string" },
        "type": { "const": "AgentRole" },
        "name": { "type": "string" },
        "gate": { "type": "integer", "minimum": 1, "maximum": 10 },
        "frequencyHz": { "type": "number" },
        "role": { "type": "string" },
        "charter": { "type": "string" },
        "authority": {
          "type": "object",
          "required": ["scopes", "owns", "maxWaivableSeverity"],
          "properties": {
            "scopes": {
              "type": "array",
              "items": {
                "enum": [
                  "canon:read",
                  "canon:propose",
                  "canon:approve-staging",
                  "canon:escalate-to-creator",
                  "world:read",
                  "world:write",
                  "rights:assign",
                  "pack:export",
                  "pack:merge"
                ]
              }
            },
            "owns": { "type": "array", "items": { "type": "string" } },
            "maxWaivableSeverity": {
              "enum": ["info", "warning", "error", "blocker"]
            }
          }
        }
      }
    }
  }
}
