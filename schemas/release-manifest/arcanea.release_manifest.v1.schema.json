{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcanea.ai/schemas/arcanea.release_manifest.v1.schema.json",
  "type": "object",
  "required": ["schema", "releaseId", "canonStatus", "rights"],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "type": "string",
      "const": "arcanea.release_manifest.v1"
    },
    "releaseId": {
      "type": "string",
      "minLength": 3
    },
    "canonStatus": {
      "type": "string",
      "enum": ["LOCKED", "STAGING"],
      "description": "Must be an active canon status. Stale canon (e.g. STALE) is rejected."
    },
    "rights": {
      "type": "object",
      "required": ["commercialCleared", "licenseType"],
      "additionalProperties": false,
      "properties": {
        "commercialCleared": {
          "type": "boolean",
          "const": true,
          "description": "Rights must be cleared for release."
        },
        "licenseType": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
