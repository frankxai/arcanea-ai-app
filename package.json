{
  "name": "arcanea",
  "version": "1.0.0",
  "description": "AI-powered creative ecosystem empowering the next generation of creators",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:academy": "turbo run dev --filter=@arcanea/academy",
    "dev:web": "turbo run dev --filter=@arcanea/web",
    "dev:chat": "turbo run dev --filter=@arcanea/chat",
    "dev:studio": "turbo run dev --filter=@arcanea/studio",
    "dev:gallery": "turbo run dev --filter=@arcanea/gallery",
    "dev:library": "turbo run dev --filter=@arcanea/library",
    "dev:realms": "turbo run dev --filter=@arcanea/realms",
    "dev:sanctuary": "turbo run dev --filter=@arcanea/sanctuary",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:all": "node --test packages/*/tests/*.test.mjs",
    "test:quick": "pnpm --filter @arcanea/core build && pnpm --filter @arcanea/extension-core build && node --test packages/extension-core/tests/*.test.mjs packages/auth/tests/*.test.mjs packages/core/tests/*.test.mjs packages/arcanea-mcp/tests/*.test.mjs",
    "test:luminor-read-timeout": "node --test scripts/tests/luminor-read-timeout-contract.test.mjs",
    "test:health-media-readiness": "node --test scripts/tests/health-media-readiness-contract.test.mjs",
    "test:worlds-accessibility": "node --test scripts/tests/worlds-accessibility-contract.test.mjs",
    "test:release-manifest": "node --test scripts/tests/release-manifest-schema.test.mjs",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean",
    "supabase:project-graph:plan": "tsx scripts/project-graph-activate.ts --plan",
    "supabase:project-graph:apply": "tsx scripts/project-graph-activate.ts --apply",
    "build:registry": "node oss/skills/scripts/build-registry.mjs",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,md,json}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,md,json}\"",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build --filter=!@arcanea/mobile && changeset publish",
    "agents:bridge": "node scripts/generate-codex-claude-bridge.mjs",
    "agents:bridge:check": "node scripts/generate-codex-claude-bridge.mjs --check",
    "agents:surface": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/agent-surface-watch.ps1",
    "agents:surface:watch": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/agent-surface-watch.ps1 -Watch",
    "ops:health": "node scripts/ops-health-check.js --quick",
    "ops:health:deep": "node scripts/ops-health-check.js --quick --deep",
    "ops:release-gate": "node scripts/ops-health-check.js --quick --deep --json",
    "ops:machine": "node scripts/machine-readiness-check.js",
    "ops:machine:json": "node scripts/machine-readiness-check.js --json",
    "verify:runtime-contracts": "node scripts/verify-runtime-engine-contracts.mjs",
    "verify:web-lint-runtime": "node scripts/verify-web-lint-runtime.mjs",
    "verify:project-workspaces": "tsx scripts/verify-project-workspaces.ts",
    "visual:review-packet": "tsx scripts/export-visual-encyclopedia-review-packet.ts",
    "arcanea:visual:format": "prettier --write --no-error-on-unmatched-pattern \"apps/web/data/arcanea-*.v1.json\" \"apps/web/public/downloads/arcanea-constellation/**/*.json\" \"planning-with-files/arcanea-visual-campaign/**/*.json\" \"planning-with-files/arcanea-visual-reflections/*.json\" \"planning-with-files/arcanea-visual-results/*.json\" \"planning-with-files/arcanea-visual-releases/*.json\" \"planning-with-files/arcanea-visual-references/**/*.json\" \"planning-with-files/arcanea-visual-reference-assignments/*.json\"",
    "arcanea:visual:build": "node scripts/build-arcanea-living-constellation.mjs && node scripts/compile-arcanea-visual-round.mjs --round 1 && node scripts/compile-arcanea-provider-packets.mjs --round 1 --provider all && node scripts/build-arcanea-visual-workbench.mjs",
    "arcanea:visual:verify": "pnpm arcanea:visual:build && node scripts/validate-arcanea-living-constellation.mjs && pnpm arcanea:visual:tooling && pnpm arcanea:visual:schema && pnpm arcanea:visual:test",
    "arcanea:visual:record": "node scripts/record-arcanea-image-result.mjs",
    "arcanea:visual:score": "node scripts/score-arcanea-visual-round.mjs",
    "arcanea:visual:blind-review": "node scripts/prepare-arcanea-blind-review.mjs",
    "arcanea:visual:reconcile": "node scripts/reconcile-arcanea-blind-review.mjs",
    "arcanea:visual:reference:register": "node scripts/register-arcanea-visual-reference.mjs",
    "arcanea:visual:reference:qualify": "node scripts/qualify-arcanea-identity-reference-set.mjs",
    "arcanea:visual:reference:assign": "node scripts/assign-arcanea-identity-references.mjs",
    "arcanea:visual:decide": "node scripts/decide-arcanea-image-release.mjs",
    "arcanea:visual:provider-pack": "node scripts/compile-arcanea-provider-packets.mjs",
    "arcanea:visual:workbench": "node scripts/build-arcanea-visual-workbench.mjs",
    "arcanea:visual:preflight": "node scripts/capture-arcanea-machine-preflight.mjs",
    "arcanea:visual:grant": "node scripts/issue-arcanea-visual-execution-grant.mjs",
    "arcanea:visual:readiness": "node scripts/report-arcanea-visual-readiness.mjs",
    "arcanea:visual:source:verify": "node scripts/verify-arcanea-external-visual-source.mjs",
    "arcanea:visual:prior-evidence": "node scripts/verify-arcanea-prior-visual-evidence.mjs",
    "arcanea:visual:tooling": "node scripts/audit-arcanea-visual-tooling-surfaces.mjs",
    "arcanea:visual:schema": "node scripts/validate-arcanea-visual-contract-schemas.mjs",
    "arcanea:visual:test": "node --test scripts/tests/arcanea-image-metadata.test.mjs scripts/tests/arcanea-visual-governance.test.mjs",
    "arcanea:visual:typecheck": "tsc -p apps/web/tsconfig.constellation.json --pretty false",
    "verify:open-library": "node scripts/verify-open-library-content.mjs",
    "embed:library": "cd apps/web && npx tsx ../../scripts/embed-library.ts",
    "embed:library:dry-run": "cd apps/web && npx tsx ../../scripts/embed-library.ts --dry-run --verbose",
    "sis:sync": "node scripts/sis-context-bridge.mjs",
    "sis:mcp": "node scripts/sis-mcp-server.mjs",
    "sis:append": "node scripts/sis-write.mjs",
    "sis:contracts": "node scripts/sis-contract-check.mjs",
    "sis:schema-check": "node scripts/sis-schema-check.mjs",
    "sis:legacy-export": "node scripts/sis-legacy-export.mjs",
    "sis:check": "node scripts/sis-context-bridge.mjs && node scripts/sis-check.mjs"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "dotenv": "^16.4.5",
    "glob": "^11.0.0",
    "stripe": "^20.4.1"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@tailwindcss/typography": "^0.5.20",
    "@turbo/gen": "^2.11.4",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.4",
    "next": "16.3.8",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "semver": "^7.8.5",
    "tailwindcss": "^3.4.9",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.23.15",
    "turbo": "^2.11.4",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.28.4",
  "keywords": [
    "ai",
    "creativity",
    "education",
    "community",
    "creators",
    "artificial-intelligence",
    "creative-tools",
    "learning-platform",
    "next-js",
    "react-native",
    "typescript"
  ],
  "author": {
    "name": "Frank Riemer",
    "email": "frank@arcanea.ai",
    "url": "https://github.com/frankxai"
  },
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/frankxai/arcanea.git"
  },
  "bugs": {
    "url": "https://github.com/frankxai/arcanea/issues"
  },
  "homepage": "https://arcanea.ai"
}
