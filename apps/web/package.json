  "scripts": {
    "dev": "node ../../scripts/build-creator-starters.mjs && next dev -p 3001",
    "build": "node ../../scripts/build-creator-starters.mjs && next build",
    "build:check": "pnpm run check:env && pnpm run type-check && pnpm run build",
    "start": "next start -p 3001",
    "test:e2e": "playwright test",
    "test:e2e:list": "playwright test --list",
    "test:e2e:headed": "playwright test --headed",
    "test:agentdb": "tsx lib/agentdb/__tests__/store.test.ts",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "test:projects": "tsx lib/projects/__tests__/retrieval.test.ts && tsx lib/projects/__tests__/enrichment.test.ts && tsx lib/projects/__tests__/progress.test.ts && tsx lib/projects/__tests__/trace.test.ts && tsx lib/projects/__tests__/api-contracts.test.ts && tsx lib/projects/__tests__/api-actions.test.ts && tsx lib/chat/__tests__/local-store-projects.test.ts && tsx lib/chat/__tests__/runtime-metadata.test.ts && tsx lib/analytics/__tests__/events-projects.test.ts && tsx lib/docs/__tests__/api-contracts.test.ts",
    "test:media": "tsx lib/media/__tests__/gallery-contract.test.ts",
    "test:mcp-world-context": "tsx --test lib/mcp/__tests__/world-context.test.ts",
    "test:saga-gate": "tsx --test lib/saga/__tests__/public-release-gate.test.ts",
    "test:models": "tsx lib/models/__tests__/models-data.test.ts && tsx --test lib/models/__tests__/live-models.test.ts",
    "type-check": "node -e \"require('fs').rmSync('.next/types',{recursive:true,force:true});require('fs').rmSync('.next/dev/types',{recursive:true,force:true});require('fs').rmSync('tsconfig.tsbuildinfo',{force:true})\" && next typegen && tsc --noEmit",
    "check:env": "tsx ../../scripts/check-env.ts",
    "db:push": "echo 'Use Supabase CLI for migrations'",
    "db:studio": "echo 'Use Supabase Studio at https://supabase.com/dashboard'"
  },
