# Arcanea Web App — Environment Variables
# Copy to .env.local and fill in values. NEVER commit .env.local.

# Base URL for the application (used for canonical URLs, OG tags, OAuth callbacks)
# Production: https://www.arcanea.ai
# Development: http://localhost:3001 (apps/web runs `next dev -p 3001`)
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Polar webhook (order.paid, customer.state_changed) — from Polar dashboard
# after creating the webhook endpoint pointed at /api/webhook/polar
POLAR_WEBHOOK_SECRET=whsec_...

# GitHub integration for Author Studio publish flow
# Fine-grained PAT with Contents:Write scope on arcanea-ai-app
GITHUB_TOKEN=ghp_...
GITHUB_OWNER=frankxai
GITHUB_REPO=arcanea-ai-app
GITHUB_BRANCH=main

# Supabase — read by apps/web/lib/supabase/env.ts. Without a URL and anon key
# the app falls back to a placeholder project, so sign-in won't work.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Accepted instead of the anon key for public reads:
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-side aliases (used when the NEXT_PUBLIC_ names are unset):
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_PUBLISHABLE_KEY=
# Required for admin operations (lib/supabase/env.ts throws without it)
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini — set both to the same key. GOOGLE_GENERATIVE_AI_API_KEY is read
# by lib/gateway/models.ts and tried first by app/api/create and app/api/ai/chat.
# GEMINI_API_KEY is required by scripts/check-env.ts and is the fallback name.
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_API_KEY=
