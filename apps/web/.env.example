# Arcanea Web App — Environment Variables
# Copy to .env.local and fill in values. NEVER commit .env.local.

# Base URL for the application (used for canonical URLs, OG tags, OAuth callbacks)
# Production: https://www.arcanea.ai
# Development: http://localhost:3001 (apps/web runs `next dev -p 3001`)
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Polar webhook (order.paid, customer.state_changed) — from Polar dashboard
# after creating the webhook endpoint pointed at /api/webhook/polar
POLAR_WEBHOOK_SECRET=whsec_...
# Polar organization access token (Settings → Developers). Use a sandbox token
# with POLAR_SERVER=sandbox until the first real order is verified end to end.
POLAR_ACCESS_TOKEN=polar_oat_...
POLAR_SERVER=sandbox
# Explicit release approval; credentials alone never open purchase entry points.
ARCANEA_BILLING_ENABLED=false
# Polar product ids, one per SKU in apps/web/lib/billing/catalog.ts.
# Checkout for a SKU stays closed (503) until its product id is present.
POLAR_PRODUCT_CREATOR=
POLAR_PRODUCT_STUDIO=
POLAR_PRODUCT_PACK_500=
POLAR_PRODUCT_PACK_2500=
POLAR_PRODUCT_PACK_8000=
# Canonical origin used in checkout success and portal return URLs.
NEXT_PUBLIC_SITE_URL=https://www.arcanea.ai

# GitHub integration for Author Studio publish flow
# Fine-grained PAT with Contents:Write scope on arcanea-ai-app
GITHUB_TOKEN=ghp_...
GITHUB_OWNER=frankxai
GITHUB_REPO=arcanea-ai-app
GITHUB_BRANCH=main

# Supabase — sign-in reads getSupabaseEnv() in apps/web/lib/supabase/env.ts.
# It needs a URL and an anon key; without them it falls back to a placeholder
# project and sign-in won't work.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side aliases for sign-in, each used when its NEXT_PUBLIC_ name is unset:
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# Public-read binding only (not used for sign-in):
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_PUBLISHABLE_KEY=
# Required for admin operations (lib/supabase/env.ts throws without it)
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini — set both to the same key. GOOGLE_GENERATIVE_AI_API_KEY is read
# by lib/gateway/models.ts and tried first by app/api/create and app/api/ai/chat.
# GEMINI_API_KEY is required by scripts/check-env.ts and is the fallback name.
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_API_KEY=
