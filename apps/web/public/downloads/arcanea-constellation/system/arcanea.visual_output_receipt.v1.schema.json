{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcanea.ai/schemas/arcanea.visual_output_receipt.v1.schema.json",
  "title": "Arcanea visual output receipt v1",
  "description": "Write-once lineage from current prompt and authority evidence to one decoded internal image.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "campaignId",
    "campaignVersion",
    "jobId",
    "round",
    "revision",
    "promptContractHash",
    "sourceRefs",
    "canonState",
    "identityState",
    "rightsState",
    "releaseState",
    "execution",
    "output",
    "deterministicChecks",
    "createdAt",
    "receiptHash"
  ],
  "properties": {
    "schema": { "const": "arcanea.visual_output_receipt.v1" },
    "campaignId": { "type": "string", "minLength": 3 },
    "campaignVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "jobId": { "type": "string", "pattern": "^ACV-\\d{3}$" },
    "round": { "type": "integer", "minimum": 1, "maximum": 10 },
    "revision": { "type": "integer", "minimum": 1 },
    "promptContractHash": { "$ref": "#/$defs/sha256" },
    "sourceRefs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 3 }
    },
    "canonState": { "type": "string", "minLength": 3 },
    "identityState": { "type": "string", "minLength": 3 },
    "rightsState": { "type": "string", "minLength": 3 },
    "releaseState": { "const": "internal-review" },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "providerProfile",
        "modelPolicy",
        "model",
        "parameters",
        "generationReceipt",
        "machinePreflightReceipt",
        "machinePreflightReceiptHash",
        "executionGrantPath",
        "executionGrantHash",
        "spendApprovedBy",
        "rightsAndLikenessAttestedBy",
        "authorityEvidence",
        "humanAttestation",
        "specialistReviewEvidence",
        "executionManifestPath",
        "executionManifestHash",
        "sourceContractSetHash",
        "promptCompilerVersion",
        "executionPromptHash",
        "referenceHashes",
        "qualifiedIdentityReferenceSet",
        "acceptedReferences"
      ],
      "properties": {
        "provider": { "type": "string", "minLength": 3 },
        "providerProfile": { "type": "string", "minLength": 3 },
        "modelPolicy": { "type": "string", "minLength": 3 },
        "model": { "type": ["string", "null"] },
        "parameters": { "type": "object" },
        "generationReceipt": { "type": "string", "minLength": 3 },
        "machinePreflightReceipt": { "type": "string", "minLength": 3 },
        "machinePreflightReceiptHash": { "$ref": "#/$defs/sha256" },
        "executionGrantPath": { "type": "string", "minLength": 3 },
        "executionGrantHash": { "$ref": "#/$defs/sha256" },
        "spendApprovedBy": { "type": "string", "minLength": 2 },
        "rightsAndLikenessAttestedBy": { "type": "string", "minLength": 2 },
        "authorityEvidence": { "type": "string", "minLength": 12 },
        "humanAttestation": { "const": true },
        "specialistReviewEvidence": { "type": "array" },
        "executionManifestPath": { "type": "string", "minLength": 3 },
        "executionManifestHash": { "$ref": "#/$defs/sha256" },
        "sourceContractSetHash": { "$ref": "#/$defs/sha256" },
        "promptCompilerVersion": { "type": "string", "minLength": 3 },
        "executionPromptHash": { "$ref": "#/$defs/sha256" },
        "referenceHashes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/sha256" }
        },
        "qualifiedIdentityReferenceSet": { "type": ["object", "null"] },
        "acceptedReferences": { "type": "array" }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "storagePath",
        "publicUrl",
        "fileName",
        "format",
        "width",
        "height",
        "bytes",
        "sha256",
        "ingestSourceName"
      ],
      "properties": {
        "storagePath": { "type": "string", "minLength": 3 },
        "publicUrl": { "const": null },
        "fileName": { "type": "string", "minLength": 3 },
        "format": { "enum": ["png", "jpeg", "webp"] },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "ingestSourceName": { "type": "string", "minLength": 1 }
      }
    },
    "deterministicChecks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decoded",
        "dimensionsRecorded",
        "declaredAspectRatio",
        "actualAspectRatio",
        "aspectRatioRelativeError",
        "aspectRatioTolerance",
        "aspectRatioMatchesContract",
        "storedCopyDecoded",
        "storedBytesMatchSource",
        "storedDimensionsMatchSource",
        "hashRecorded",
        "promptHashMatchesCampaign"
      ],
      "properties": {
        "decoded": { "const": true },
        "dimensionsRecorded": { "const": true },
        "declaredAspectRatio": {
          "enum": [
            "1:1",
            "4:5",
            "3:2",
            "2:3",
            "4:3",
            "3:4",
            "16:9",
            "9:16",
            "21:9"
          ]
        },
        "actualAspectRatio": { "type": "number", "minimum": 0.01 },
        "aspectRatioRelativeError": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.015
        },
        "aspectRatioTolerance": { "const": 0.015 },
        "aspectRatioMatchesContract": { "const": true },
        "storedCopyDecoded": { "const": true },
        "storedBytesMatchSource": { "const": true },
        "storedDimensionsMatchSource": { "const": true },
        "hashRecorded": { "const": true },
        "promptHashMatchesCampaign": { "const": true }
      }
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "receiptHash": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
