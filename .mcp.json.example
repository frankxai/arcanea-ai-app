{
  "mcpServers": {
    "next-devtools": {
      "command": "npx",
      "args": ["-y", "next-devtools-mcp@latest"],
      "env": {},
      "description": "Next.js development tools - runtime errors, logs, and page metadata"
    },
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {},
      "description": "GitHub integration for Arcanea repository management, PRs, and issues"
    },
    "figma-remote-mcp": {
      "type": "http",
      "url": "https://mcp.figma.com/mcp"
    },
    "notion": {
      "type": "http",
      "url": "https://mcp.notion.com/mcp"
    },
    "linear-server": {
      "type": "sse",
      "url": "https://mcp.linear.app/sse"
    },
    "supabase": {
      "type": "http",
      "url": "https://mcp.supabase.com/mcp?project_ref=YOUR_PROJECT_REF",
      "description": "Supabase project management, SQL, migrations, and auth (OAuth — no token needed)"
    },
    "arcanea-mcp": {
      "command": "node",
      "args": ["/mnt/c/Users/frank/Arcanea/packages/arcanea-mcp/dist/cli.js"],
      "env": {},
      "description": "Arcanea local MCP server (worldbuilding, creative orchestration, canon tools)"
    },
    "arcanea-memory": {
      "command": "node",
      "args": ["C:/Users/frank/Arcanea/scripts/arcanea-memory-compat-mcp.mjs"],
      "env": {
        "STARLIGHT_HOME": "C:/Users/frank/.starlight",
        "LEGACY_MEMORY_OUT": "C:/Users/frank/Arcanea/.arcanea/memory"
      },
      "description": "Arcanea memory compatibility MCP (vault_remember, vault_recall, horizon)"
    },
    "starlight-sis": {
      "command": "node",
      "args": ["C:/Users/frank/Arcanea/scripts/sis-mcp-server.mjs"],
      "env": {
        "STARLIGHT_HOME": "C:/Users/frank/.starlight"
      },
      "description": "Starlight SIS canonical MCP server (append entries, stats, continuity substrate)"
    },
    "playwright": {
      "command": "npx",
      "args": ["-y", "@executeautomation/playwright-mcp-server"],
      "env": {},
      "description": "Browser automation for E2E testing and UI verification"
    },
    "arcanea-claw": {
      "command": "node",
      "args": [
        "/mnt/c/Users/frank/Arcanea/arcanea-claw/mcp-server/dist/index.js"
      ],
      "env": {
        "CLAW_DIR": "/mnt/c/Users/frank/Arcanea/arcanea-claw",
        "MANIFEST_PATH": "/mnt/c/Users/frank/Arcanea/arcanea-claw/manifest.json"
      },
      "description": "ArcaneaClaw media pipeline — scan, classify, score, approve/reject creative assets"
    },
    "magic": {
      "command": "npx",
      "args": ["-y", "@21st-dev/magic@latest"],
      "env": {
        "API_KEY": "${TWENTYFIRST_API_KEY}"
      },
      "description": "21st.dev Magic — premium UI component generation (heroes, bento, marquee, beams, auroras)"
    },
    "v0": {
      "command": "npx",
      "args": ["-y", "v0-mcp@latest"],
      "env": {
        "V0_API_KEY": "${V0_API_KEY}"
      },
      "description": "Vercel v0 — AI component and page generation (complement to Magic)"
    },
    "fal": {
      "command": "npx",
      "args": ["-y", "fal-mcp@latest"],
      "env": {
        "FAL_KEY": "${FAL_KEY}"
      },
      "description": "Fal.ai — fast FLUX Pro, Stable Video, real-time image/video inference"
    },
    "gemini": {
      "command": "npx",
      "args": ["-y", "gemini-mcp-tool@latest"],
      "env": {
        "GEMINI_API_KEY": "${GEMINI_API_KEY}"
      },
      "description": "Google Gemini — Gemini 2.5/3.x + NB2 (gemini-3.1-flash-image-preview), Arcanea default for image gen"
    },
    "replicate": {
      "command": "npx",
      "args": ["-y", "replicate-mcp@latest"],
      "env": {
        "REPLICATE_API_TOKEN": "${REPLICATE_API_TOKEN}"
      },
      "description": "Replicate — custom fine-tuned models + Wan video + community model catalog"
    }
  }
}
