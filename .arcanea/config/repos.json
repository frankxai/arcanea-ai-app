{
  "$schema": "Arcanea cross-repo registry - source of truth for multi-repo automation",
  "lastUpdated": "2026-05-11",
  "repos": [
    {
      "name": "arcanea-ai-app",
      "description": "Main platform - arcanea.ai production",
      "github": "frankxai/arcanea-ai-app",
      "role": "production",
      "stack": ["next.js", "react", "typescript", "supabase"],
      "vercel": "arcanea-ai-appx",
      "branch": "main",
      "dependencies": ["@arcanea/core", "@arcanea/aios"],
      "active": true,
      "layer": "surface",
      "gate": "unity",
      "hemisphere": "seam"
    },
    {
      "name": "arcanea",
      "description": "OSS monorepo - the open-source engine",
      "github": "frankxai/arcanea",
      "role": "oss",
      "stack": ["typescript", "node"],
      "branch": "main",
      "publishes": ["@arcanea/core", "@arcanea/aios", "@arcanea/sdk"],
      "active": true,
      "layer": "substrate",
      "gate": "source",
      "hemisphere": "seam"
    },
    {
      "name": "oh-my-arcanea",
      "description": "Universal Arcanea agent harness target; current code remains OpenCode-derived until adapter cleanup",
      "github": "frankxai/oh-my-arcanea",
      "role": "harness",
      "stack": ["typescript", "bun", "yaml", "markdown"],
      "branch": "dev",
      "active": true,
      "layer": "surface",
      "gate": "voice",
      "hemisphere": "arc"
    },
    {
      "name": "arcanea-records",
      "description": "Music studio - Suno integration, soundscapes",
      "github": "frankxai/arcanea-records",
      "role": "product",
      "stack": ["next.js", "typescript"],
      "branch": "main",
      "active": true,
      "layer": "product",
      "gate": "voice",
      "hemisphere": "arc"
    },
    {
      "name": "starlight-intelligence-system",
      "description": "Starlight Intelligence System - SIS/SIP substrate, memory/context layer, MCP servers, adapters",
      "github": "frankxai/Starlight-Intelligence-System",
      "role": "substrate",
      "stack": ["typescript", "node", "next.js", "mcp"],
      "publishes": ["@arcanea/starlight-intelligence-system"],
      "branch": "main",
      "active": true,
      "layer": "substrate",
      "gate": "source",
      "hemisphere": "seam"
    },
    {
      "name": "starlight",
      "description": "Minimal SIP adoption kit for Starlight Intelligence System",
      "github": "frankxai/starlight",
      "role": "adoption-kit",
      "stack": ["markdown"],
      "branch": "main",
      "active": true,
      "layer": "product",
      "gate": "form",
      "hemisphere": "arc"
    },
    {
      "name": "vibe-os-substrate",
      "description": "SIP-conformant vertical scaffold for state engineering",
      "github": "frankxai/vibe-os-substrate",
      "role": "vertical",
      "stack": ["markdown"],
      "branch": "main",
      "active": true,
      "layer": "product",
      "gate": "form",
      "hemisphere": "arc"
    },
    {
      "name": "arcanea-orchestrator",
      "description": "Parallel AI coding agent orchestration runtime across repos and agent runtimes",
      "github": "frankxai/arcanea-orchestrator",
      "role": "orchestration",
      "stack": ["typescript", "node", "pnpm"],
      "branch": "main",
      "active": true,
      "layer": "substrate",
      "gate": "unity",
      "hemisphere": "seam"
    },
    {
      "name": "arcanea-code",
      "description": "Guardian-powered coding CLI fork; consumes harness/substrate but is not the universal harness",
      "github": "frankxai/arcanea-code",
      "role": "coding-cli",
      "stack": ["typescript", "bun", "opencode"],
      "branch": "dev-v2",
      "active": true,
      "layer": "surface",
      "gate": "form",
      "hemisphere": "seam"
    },
    {
      "name": "arcanea-claw",
      "description": "AI media engine (NanoClaw fork)",
      "github": "frankxai/arcanea-claw",
      "visibility": "public",
      "role": "content-engine",
      "stack": ["typescript", "node", "nanoclaw"],
      "branch": "main",
      "active": true,
      "layer": "product",
      "gate": "vision",
      "hemisphere": "arc"
    },
    {
      "name": "arcanea-flow",
      "description": "Multi-agent orchestration (claude-flow/ruflo fork)",
      "github": "frankxai/arcanea-flow",
      "upstream": "ruvnet/ruflo",
      "visibility": "public",
      "role": "intelligence-orchestration",
      "stack": ["typescript", "node"],
      "branch": "main",
      "active": true,
      "layer": "substrate",
      "gate": "pattern",
      "hemisphere": "seam"
    },
    {
      "name": "arcanea-onchain",
      "description": "Economic layer and Guardian assets",
      "github": "frankxai/arcanea-onchain",
      "visibility": "public",
      "role": "economy",
      "stack": ["solidity", "typescript"],
      "branch": "main",
      "active": true,
      "layer": "substrate",
      "gate": "pattern",
      "hemisphere": "seam"
    },
    {
      "name": "arcanea-mobile",
      "description": "Mobile application (Flutter/Compose)",
      "github": "frankxai/arcanea-mobile",
      "visibility": "public",
      "role": "mobile",
      "stack": ["flutter", "compose"],
      "branch": "master",
      "active": true,
      "layer": "product",
      "gate": "form",
      "hemisphere": "arc"
    },
    {
      "name": "arcanea-intelligence-os",
      "description": "Mythology-infused agent orchestration",
      "github": "frankxai/arcanea-intelligence-os",
      "localDir": "intelligence-os",
      "visibility": "public",
      "role": "intelligence-os",
      "stack": ["typescript", "node"],
      "branch": "master",
      "active": true,
      "layer": "substrate",
      "gate": "unity",
      "hemisphere": "seam"
    },
    {
      "name": "arcanea-infogenius",
      "description": "Knowledge-first visual intelligence MCP",
      "github": "frankxai/arcanea-infogenius",
      "visibility": "public",
      "role": "knowledge-mcp",
      "stack": ["typescript", "mcp"],
      "branch": "main",
      "active": true,
      "layer": "substrate",
      "gate": "vision",
      "hemisphere": "seam"
    },
    {
      "name": "arcanea-vault",
      "description": "Browser extension and capture/export/provenance layer feeding Arcanea and SIS",
      "github": "frankxai/arcanea-vault",
      "role": "capture",
      "stack": ["typescript", "vite", "extension"],
      "branch": "codex/excellence-vault-baseline",
      "active": true,
      "layer": "product",
      "gate": "form",
      "hemisphere": "arc"
    },
    {
      "name": "arcaneabot",
      "description": "Integration bot (moltbot fork)",
      "github": "moltbot/moltbot",
      "visibility": "public",
      "role": "integration",
      "stack": ["typescript"],
      "branch": "main",
      "active": true,
      "layer": "product",
      "gate": "form",
      "hemisphere": "arc"
    },
    {
      "name": "arcanea-mcp",
      "description": "Historical MCP infrastructure entry - verify URL/access/name before use",
      "github": "frankxai/arcanea-mcp",
      "role": "infrastructure-unresolved",
      "stack": ["typescript", "node"],
      "publishes": ["@arcanea/mcp"],
      "branch": "main",
      "active": false,
      "layer": "product",
      "gate": "form",
      "hemisphere": "arc"
    },
    {
      "name": "arcanea-memory",
      "description": "Historical memory MCP entry - likely superseded or absorbed by Starlight Intelligence System",
      "github": "frankxai/arcanea-memory",
      "role": "infrastructure-unresolved",
      "stack": ["typescript", "node"],
      "publishes": ["@arcanea/memory-mcp"],
      "branch": "main",
      "active": false,
      "layer": "product",
      "gate": "form",
      "hemisphere": "arc"
    },
    {
      "name": "claude-flow",
      "description": "Upstream multi-agent orchestration framework; Arcanea fork is arcanea-flow",
      "github": "ruvnet/claude-flow",
      "role": "upstream-runtime",
      "stack": ["typescript", "node"],
      "publishes": ["@claude-flow/cli"],
      "branch": "main",
      "active": true,
      "layer": "product",
      "gate": "form",
      "hemisphere": "arc"
    }
  ],
  "syncRules": {
    "sharedTypes": {
      "source": "arcanea",
      "targets": ["arcanea-ai-app"],
      "trigger": "tag"
    },
    "substrate": {
      "source": "starlight-intelligence-system",
      "targets": ["arcanea-ai-app", "oh-my-arcanea", "arcanea-orchestrator", "arcanea-code", "arcanea-vault"],
      "trigger": "release"
    },
    "harness": {
      "source": "oh-my-arcanea",
      "targets": ["arcanea-ai-app", "arcanea-orchestrator", "arcanea-code"],
      "trigger": "manual",
      "syncPaths": [".claude/agents/", ".claude/skills/", ".arcanea/"]
    }
  }
}
