{
  "$schema": "Arcanea cross-repo registry - source of truth for multi-repo automation",
  "lastUpdated": "2026-05-10",
  "repos": [
    {
      "name": "arcanea-ai-app",
      "description": "Main platform - arcanea.ai production",
      "github": "frankxai/arcanea-ai-app",
      "visibility": "private",
      "publicUrl": "https://arcanea.ai",
      "role": "production",
      "stack": ["next.js", "react", "typescript", "supabase"],
      "vercel": "arcanea-ai-appx",
      "branch": "main",
      "dependencies": ["@arcanea/core", "@arcanea/aios"],
      "active": true
    },
    {
      "name": "arcanea",
      "description": "OSS monorepo - the open-source engine",
      "github": "frankxai/arcanea",
      "visibility": "public",
      "publicUrl": "https://github.com/frankxai/arcanea",
      "role": "oss",
      "stack": ["typescript", "node"],
      "branch": "main",
      "publishes": ["@arcanea/core", "@arcanea/aios", "@arcanea/sdk"],
      "active": true
    },
    {
      "name": "oh-my-arcanea",
      "description": "Universal Arcanea agent harness target",
      "github": "frankxai/oh-my-arcanea",
      "upstream": "code-yeongyu/oh-my-openagent",
      "visibility": "public",
      "publicUrl": "https://github.com/frankxai/oh-my-arcanea",
      "role": "harness",
      "stack": ["typescript", "bun", "yaml", "markdown"],
      "branch": "dev",
      "active": true
    },
    {
      "name": "arcanea-records",
      "description": "Music studio - Suno integration, soundscapes",
      "github": "frankxai/arcanea-records",
      "visibility": "public",
      "publicUrl": "https://github.com/frankxai/arcanea-records",
      "role": "product",
      "stack": ["next.js", "typescript"],
      "branch": "main",
      "active": true
    },
    {
      "name": "starlight-intelligence-system",
      "description": "Starlight Intelligence System substrate",
      "github": "frankxai/Starlight-Intelligence-System",
      "visibility": "public",
      "publicUrl": "https://github.com/frankxai/Starlight-Intelligence-System",
      "role": "substrate",
      "stack": ["typescript", "node", "next.js", "mcp"],
      "publishes": ["@arcanea/starlight-intelligence-system"],
      "branch": "main",
      "active": true
    },
    {
      "name": "arcanea-orchestrator",
      "description": "Multi-agent orchestration runtime",
      "github": "frankxai/arcanea-orchestrator",
      "upstream": "ComposioHQ/agent-orchestrator",
      "visibility": "public",
      "publicUrl": "https://github.com/frankxai/arcanea-orchestrator",
      "role": "orchestration",
      "stack": ["typescript", "node", "pnpm"],
      "branch": "main",
      "active": true
    },
    {
      "name": "arcanea-code",
      "description": "Guardian-powered coding CLI",
      "github": "frankxai/arcanea-code",
      "upstream": "anomalyco/opencode",
      "visibility": "public",
      "publicUrl": "https://github.com/frankxai/arcanea-code",
      "role": "coding-cli",
      "stack": ["typescript", "bun", "opencode"],
      "branch": "dev",
      "active": true
    },
    {
      "name": "arcanea-claw",
      "description": "AI media engine (NanoClaw fork)",
      "github": "frankxai/arcanea-claw",
      "visibility": "public",
      "role": "content-engine",
      "stack": ["typescript", "node", "nanoclaw"],
      "branch": "main",
      "active": true
    },
    {
      "name": "arcanea-flow",
      "description": "Multi-agent orchestration (claude-flow/ruflo fork)",
      "github": "frankxai/arcanea-flow",
      "upstream": "ruvnet/ruflo",
      "visibility": "public",
      "role": "intelligence-orchestration",
      "stack": ["typescript", "node"],
      "branch": "main",
      "active": true
    },
    {
      "name": "arcanea-onchain",
      "description": "Economic layer and Guardian assets",
      "github": "frankxai/arcanea-onchain",
      "visibility": "public",
      "role": "economy",
      "stack": ["solidity", "typescript"],
      "branch": "main",
      "active": true
    },
    {
      "name": "arcanea-mobile",
      "description": "Mobile application (Flutter/Compose)",
      "github": "frankxai/arcanea-mobile",
      "visibility": "public",
      "role": "mobile",
      "stack": ["flutter", "compose"],
      "branch": "master",
      "active": true
    },
    {
      "name": "arcanea-intelligence-os",
      "description": "Mythology-infused agent orchestration",
      "github": "frankxai/arcanea-intelligence-os",
      "localDir": "intelligence-os",
      "visibility": "public",
      "role": "intelligence-os",
      "stack": ["typescript", "node"],
      "branch": "master",
      "active": true
    },
    {
      "name": "arcanea-infogenius",
      "description": "Knowledge-first visual intelligence MCP",
      "github": "frankxai/arcanea-infogenius",
      "visibility": "public",
      "role": "knowledge-mcp",
      "stack": ["typescript", "mcp"],
      "branch": "main",
      "active": true
    },
    {
      "name": "arcanea-vault",
      "description": "Cross-AI capture and provenance layer",
      "github": "frankxai/arcanea-vault",
      "visibility": "public",
      "role": "capture",
      "stack": ["typescript", "vite", "extension"],
      "branch": "codex/excellence-vault-baseline",
      "active": true
    },
    {
      "name": "arcaneabot",
      "description": "Integration bot (moltbot fork)",
      "github": "moltbot/moltbot",
      "visibility": "public",
      "role": "integration",
      "stack": ["typescript"],
      "branch": "main",
      "active": true
    }
  ],
  "syncRules": {
    "sharedTypes": {
      "source": "arcanea",
      "targets": ["arcanea-ai-app"],
      "trigger": "tag"
    },
    "substrate": {
      "source": "starlight-intelligence-system",
      "targets": ["arcanea-ai-app", "oh-my-arcanea", "arcanea-orchestrator", "arcanea-code", "arcanea-vault"],
      "trigger": "release"
    },
    "harness": {
      "source": "oh-my-arcanea",
      "targets": ["arcanea-ai-app", "arcanea-orchestrator", "arcanea-code"],
      "trigger": "manual",
      "syncPaths": [".claude/agents/", ".claude/skills/", ".arcanea/"]
    }
  }
}
