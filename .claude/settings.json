{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node C:/Users/frank/Arcanea/scripts/hooks/sis-session-start.js 2>/dev/null || true",
            "timeout": 5000,
            "continueOnError": true
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/excellence-session-start.sh 2>/dev/null || true",
            "timeout": 5000,
            "continueOnError": true
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/web-excellence-session.py"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/excellence-prompt-submit.sh 2>/dev/null || true",
            "timeout": 2000,
            "continueOnError": true
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/excellence-pre-write.sh 2>/dev/null || true",
            "timeout": 2000,
            "continueOnError": true
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/web-excellence-gate.py"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node C:/Users/frank/Arcanea/scripts/hooks/sis-pre-compact.js 2>/dev/null || true",
            "timeout": 5000,
            "continueOnError": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node C:/Users/frank/Arcanea/scripts/hooks/sis-session-end.js 2>/dev/null || true",
            "timeout": 5000,
            "continueOnError": true
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/excellence-stop.sh 2>/dev/null || true",
            "timeout": 3000,
            "continueOnError": true
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/web-excellence-stop.py"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "node \"C:/Users/frank/Arcanea/.claude/statusline.mjs\""
  },
  "permissions": {
    "allow": [],
    "deny": []
  },
  "attribution": {
    "commit": "",
    "pr": ""
  }
}
